# Root-Konto von MongoDB, nur für den mongo-Container (docker-compose.app.yml).
# Kopieren nach deploy/mongo.env und ausfüllen. Die API bekommt diese Werte nie zu sehen,
# sie nutzt ihr eigenes Konto (MONGO_USER/MONGO_PASSWORD in .env).
# Passwort z. B.: openssl rand -base64 36
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=
