# Produktiv-Konfiguration für deploy/docker-compose.{app,proxy,certbot}.yml.
# Kopieren nach deploy/.env und ausfüllen.
# Alle Variablen der API stehen mit Erklärung in apps/api/.env.example.

# ---- Images (vom Build-Skript erzeugt, siehe deploy/build-images.ps1) ----
API_IMAGE=athletept-api:latest
WEB_IMAGE=athletept-web:latest

# ---- Proxy und TLS (docker-compose.proxy.yml, docker-compose.certbot.yml) ----
# Domain der Beta, muss per DNS auf den Server zeigen
DOMAIN=beta.example.de
# Zweite Domain auf demselben Proxy (Sport-Analytics-Backend, nginx/sports.conf.template)
SPORTS_DOMAIN=sports.athlete-pt.de
# Kontakt für Let's Encrypt (Ablaufwarnungen)
CERTBOT_EMAIL=
# Optional, z. B. --staging zum Testen ohne Rate-Limits
CERTBOT_EXTRA_ARGS=

# ---- API ----
# MongoDB im Compose-Netz (Dienstname "mongo")
MONGO_URI=mongodb://mongo:27017/athletept?replicaSet=rs0
# Konto der API (nur readWrite auf "athletept"). Wird beim ersten Start von MongoDB angelegt
# (mongo-init/create-app-user.js). Das Root-Konto steht separat in mongo.env.
MONGO_USER=athletept
# z. B.: openssl rand -base64 36
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=athletept
# Mindestens 32 Zeichen, z. B.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   openssl rand -base64 48
JWT_SECRET=
# Öffentliche Adresse der Beta (für Links in Mails), mit https
APP_URL=https://beta.example.de
# Mails über Resend, Absender-Domain dort verifizieren (SPF, DKIM)
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM=AthletePT <noreply@beta.example.de>
# Web-App und API liegen unter derselben Domain: kein CORS nötig
CORS_ORIGINS=
# Ein Reverse-Proxy (nginx) vor der API
TRUST_PROXY=1
LOG_LEVEL=info

# ---- Sport-Analytics-Backend (docker-compose.sports.yml, Geheimnisse in sports.env) ----
# Projektordner zum Bauen, relativ zu deploy/
SPORTS_SRC=../Sport-Analytics-Backend
SPORTS_IMAGE=sportsalex:latest
