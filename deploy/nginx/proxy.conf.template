# nginx-Proxy vor beiden Containern (docker-compose.proxy.yml). Das nginx-Image setzt beim Start
# ${DOMAIN} aus der Umgebung ein und schreibt das Ergebnis nach /etc/nginx/conf.d/default.conf.
# nginx-Variablen wie $host bleiben unberührt, da es keine gleichnamigen Umgebungsvariablen gibt.
#
# Web-App und API laufen unter derselben Domain. Dadurch braucht es kein CORS und das
# Refresh-Cookie (Secure, SameSite=Strict, Pfad /api/v1/auth) funktioniert.

# Docker-DNS: Containernamen erst bei Anfragen auflösen. So startet der Proxy auch, wenn die App
# gerade nicht läuft, und findet neu erstellte Container ohne Neustart.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's-Encrypt-Prüfung (certbot --webroot), alles andere auf HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Die API nimmt nur JSON entgegen, große Uploads gibt es nicht.
    client_max_body_size 1m;

    # Gemeinsame Proxy-Header. Die API wertet X-Forwarded-For aus (TRUST_PROXY=1 in der .env).
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Upstreams als Variable, damit der resolver oben greift (Pfad wird unverändert weitergegeben).
    set $api_upstream http://athletept3-api:3000;
    set $web_upstream http://athletept3-web:8080;

    # API
    location /api/ {
        proxy_pass $api_upstream;
        proxy_read_timeout 30s;
    }

    # Web-App (statische Dateien aus dem Web-Container)
    location / {
        proxy_pass $web_upstream;
    }
}
