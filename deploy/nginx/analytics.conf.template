# Dritte Domain auf demselben Proxy: statische Website athlete-analytics (eigener nginx-Container).
# Das nginx-Image setzt beim Start ${ANALYTICS_DOMAIN} aus der .env ein (wie ${DOMAIN} in
# proxy.conf.template). Den resolver erbt dieser Server aus proxy.conf.template (http-Ebene),
# ein zweiter resolver-Eintrag wäre ein Fehler.
#
# Der Container "athlete-analytics" hängt im Netz "athletept-sports" und lauscht auf Port 8080
# (docker-compose.analytics.yml).

server {
    listen 80;
    listen [::]:80;
    server_name ${ANALYTICS_DOMAIN};

    # Let's-Encrypt-Prüfung (certbot --webroot), alles andere auf HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ANALYTICS_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ANALYTICS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ANALYTICS_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;


    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    set $analytics_upstream http://athlete-analytics:8080;

    location / {
        proxy_pass $analytics_upstream;
        proxy_read_timeout 30s;
    }
}
