# Kopieren nach apps/api/.env und Werte anpassen. Die API prüft alle Werte beim Start
# und startet nicht, wenn etwas fehlt oder ungültig ist.

# development | test | production. Ohne Angabe gilt "production" (sicherer Default).
NODE_ENV=development
PORT=3000

# MongoDB. Für Transaktionen wird ein Replica Set benötigt (siehe docker-compose.yml).
MONGO_URI=mongodb://localhost:27017/athletept?replicaSet=rs0&directConnection=true
# Zugangsdaten, falls sie nicht in MONGO_URI stehen. Lokal optional, in production Pflicht
# (die API startet dort sonst nicht).
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=admin

# Mindestens 32 Zeichen. Erzeugen z. B. mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Laufzeiten
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Öffentliche URL des Web-Frontends (für Links in E-Mails)
APP_URL=http://localhost:5173

# E-Mail-Versand:
#   smtp     -> lokal an Mailpit (docker-compose.dev.yml), Postfach unter http://localhost:8025
#   console  -> Mails nur ins API-Log schreiben (ohne Docker). Default in development.
#   resend   -> Produktion, braucht RESEND_API_KEY. Default in production.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=AthletePT <noreply@localhost>
# RESEND_API_KEY=

# Erlaubte Origins für CORS, kommagetrennt. Leer = keine Cross-Origin-Requests
# (im Dev-Betrieb nicht nötig, weil Vite die API über einen Proxy anspricht).
CORS_ORIGINS=

# Anzahl vertrauenswürdiger Reverse-Proxies vor der API (für korrekte Client-IP)
TRUST_PROXY=0

# Swagger-UI unter /api/v1/docs. Default: an in development, aus in production.
# API_DOCS_ENABLED=true

# error | warn | info | http | debug
# LOG_LEVEL=info
