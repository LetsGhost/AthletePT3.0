# Build-Kontext ist das Repo-Root:  docker build -f Dockerfile.web -t athletept-web .
#
# Baut die Web-App und liefert sie mit einem schlanken nginx aus. Der Container ist nur
# Auslieferer für statische Dateien: Er spricht nie mit der API. Das Routing von /api übernimmt
# der Reverse-Proxy davor (siehe deploy/nginx/proxy.conf.template).

# -------- Build Stage --------
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci --workspace @athletept/web --include-workspace-root=false

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN npm run build --workspace @athletept/web

# -------- Production Stage --------
# Unprivilegiertes Image: nginx läuft nicht als root und lauscht deshalb auf 8080.
FROM nginxinc/nginx-unprivileged:1.28-alpine

COPY deploy/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
